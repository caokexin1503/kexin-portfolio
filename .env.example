# ---------------------------------------------------------------------------
# Database (Supabase Postgres, or any Postgres connection string)
# ---------------------------------------------------------------------------
# Pooled connection (used by the app at runtime — Supabase's "Transaction" pooler, port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (used only for migrations — Supabase's "Session" connection, port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-secret"
# Base URL of the deployed site (used for callback URLs). http://localhost:3000 in dev.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Admin account (consumed once by `npm run db:seed` to create the single admin user)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Kexin Cao"

# ---------------------------------------------------------------------------
# Supabase Storage (media: images, videos, PDFs, downloadable files)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Anon/public key — safe to expose to the browser (protected by the bucket's RLS policies
# and the fact that uploads require a short-lived signed URL minted by the admin-only server action).
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key-from-supabase-dashboard"
# Service role key — server-only, NEVER expose with NEXT_PUBLIC_ prefix, never send to the client.
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-dashboard"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public canonical URL, used for sitemap.xml, robots.txt, Open Graph and canonical tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
